# Copy to `.env` (DO NOT COMMIT) before running `pnpm local-action`

# ─── Required for local Action ───────────────────────────────────────────────

# PAT with issues:write (and pull-requests:write for PR fixture tests)
GITHUB_TOKEN=ghp_replace_me

# ─── GitHub Context (required by @actions/github) ───────────────────────────

# Use `issues` for fixtures/event.json or `pull_request` for PR webhook fixtures
GITHUB_EVENT_NAME=issues
GITHUB_REPOSITORY=sneha-yadav1111/slop-scan
GITHUB_ACTOR=your-username

# Issue fixture: ./fixtures/event.json
# PR fixture: create a pull_request payload JSON (see GitHub webhook docs)
GITHUB_EVENT_PATH=./fixtures/event.json

# ─── Action inputs (optional — set as INPUT_* env vars) ──────────────────────

# INPUT_DRY-RUN=false
# INPUT_ENABLE-COMMENTS=true
# INPUT_ENABLE-LABELS=true
# INPUT_LABEL-NAME=needs-info
# INPUT_PR-LABEL-NAME=needs-review-context
# INPUT_MODEL=                    # auto | none | anthropic:... | openai:...
# INPUT_GRAY-ZONE-LOW=4
# INPUT_GRAY-ZONE-HIGH=6
# INPUT_MAX-BODY-BYTES=10000

# ─── Optional BYOK (gray-zone LLM) ─────────────────────────────────────────

# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=

# ─── Optional dashboard live feed (Action → hosted dashboard) ─────────────

# SLOP_DETECTOR_DASHBOARD_URL=https://your-app.vercel.app
# SLOP_DETECTOR_INGEST_TOKEN=
