{
  "name": "slop-detector",
  "version": "1.0.0",
  "description": "GitHub Action + shared core for Slop Detector — scores issues and PRs for information density and posts helpful checklist comments",
  "main": "dist/index.js",
  "type": "module",
  "author": "Asteam Black Shadow",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sneha-yadav1111/slop-scan.git"
  },
  "homepage": "https://github.com/sneha-yadav1111/slop-scan#readme",
  "bugs": {
    "url": "https://github.com/sneha-yadav1111/slop-scan/issues"
  },
  "scripts": {
    "build": "tsc --noEmit",
    "package": "rollup --config rollup.config.ts --configPlugin typescript",
    "bundle": "npm run format && npm run package",
    "test": "vitest run",
    "test:watch": "vitest",
    "coverage": "vitest run --coverage",
    "lint": "biome check --no-errors-on-unmatched src",
    "format": "biome format --write --no-errors-on-unmatched src",
    "all": "npm run format && npm run lint && npm run test && npm run package",
    "bench:pr": "tsx scripts/pr-benchmark.ts",
    "bench:expand-pr": "tsx scripts/expand-pr-dataset.ts",
    "bench:scrape-prs": "tsx scripts/scrape-prs.ts",
    "bench:issues": "tsx scripts/benchmark.ts --mode replay --no-llm --split test",
    "demo": "pnpm --filter slop-detector-web dev",
    "vercel-build": "pnpm --filter slop-detector-web build",
    "local-action": "npx @github/local-action run . src/action/main.ts .env"
  },
  "keywords": [
    "github-action",
    "slop-detector",
    "slop-scan",
    "issue-triage",
    "pull-request",
    "code-review",
    "actionability",
    "checklist",
    "oss-maintainer"
  ],
  "engines": {
    "node": ">=24"
  },
  "dependencies": {
    "@actions/cache": "^6.0.0",
    "@actions/core": "^3.0.1",
    "@actions/github": "^9.1.1",
    "@anthropic-ai/sdk": "^0.96.0",
    "mdast-util-to-string": "^4.0.0",
    "openai": "^6.38.0",
    "remark-gfm": "^4.0.1",
    "remark-parse": "^11.0.0",
    "unified": "^11.0.5",
    "unist-util-visit": "^5.1.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "next": "^15.1.6",
    "@biomejs/biome": "^2.4.14",
    "@octokit/plugin-throttling": "^11.0.3",
    "@octokit/rest": "^22.0.1",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.0.0",
    "@types/unist": "^3.0.3",
    "@vitest/coverage-v8": "^4.1.5",
    "p-limit": "^7.3.0",
    "rollup": "^4.60.3",
    "tslib": "^2.7.0",
    "tsx": "^4.22.0",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5"
  }
}
