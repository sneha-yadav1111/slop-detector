# Optional web dashboard env — copy to web/.env.local (DO NOT COMMIT)

# Higher GitHub API rate limits for live issue/PR URL scans
GITHUB_TOKEN=

# Gray-zone LLM adjudication (issues + PRs). Heuristics-only if all unset.
# Providers tried in priority order; first key wins.
#
# FREE (demo-friendly):
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=meta-llama/llama-3.3-70b-instruct:free
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-2.0-flash
#
# PAID:
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional model override (same semantics as Action `model` input)
# SLOP_DETECTOR_MODEL=

# Ingest token for Action → dashboard activity feed (server-side /api/ingest)
# SLOP_DETECTOR_INGEST_TOKEN=
